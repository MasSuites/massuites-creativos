# Base del API de Higgsfield (la lee solo el servidor). No cambiar salvo indicacion de Higgsfield.
HF_API_BASE_URL=https://api.higgsfield.ai

# La API key NO va aqui: cada persona la pega en la app con "Connect API key" (barra lateral)
# y se guarda en una cookie HTTP-only de su navegador. Si algun dia Direccion quiere una sola
# llave compartida para todo el equipo, hay que adaptar generation/actions.ts para leer una
# variable HF_API_KEY del servidor y guardar cada request_id con su usuario (ver README).
